rules_version = '2';

// Deny-by-default until product data models need client Firestore.
// Admin SDK / Cloud Functions bypass these rules.
// When enabling client access, scope per path + request.auth.uid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
