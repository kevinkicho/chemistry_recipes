{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:evidence": "node scripts/test-evidence-filter.mjs",
    "test:hub": "node scripts/test-hub-lib.mjs",
    "test:process-facts": "node scripts/test-process-facts.mjs",
    "test:export-ai": "node scripts/test-export-and-ai.mjs",
    "test:lib-modules": "node scripts/test-lib-modules.mjs",
    "test:tier-a": "node scripts/test-tier-a-golden.mjs",
    "test:ai-regression": "node scripts/test-ai-regression.mjs",
    "test:smoke": "node scripts/test-smoke-apis.mjs",
    "test:smoke:strict": "node scripts/test-smoke-apis.mjs --strict",
    "test:unit": "npm run test:evidence && npm run test:hub && npm run test:process-facts && npm run test:export-ai && npm run test:lib-modules && npm run test:tier-a && npm run test:ai-regression",
    "test": "npm run test:unit",
    "test:coverage": "npm run test:unit && npm run test:smoke && npx tsc --noEmit && npx eslint src --max-warnings 0",
    "test:all": "npm run test:coverage && npm run build"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.21"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "@eslint/eslintrc": "^3"
  }
}
