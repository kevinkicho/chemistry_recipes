# Chemistry Recipes — example environment (copy to .env and fill in).
# NEVER commit real .env files or API keys.
#
# Place this file at the repo root. Next.js loads it via web/next.config.ts.
# Docs: docs/getting-started.md · docs/engineering/ai-and-ollama.md · docs/security.md

# --- Ollama Cloud (optional; for dual-view AI synthesis) ---
# Key: https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=

# Optional model overrides (browser Settings → AI can also pick models)
# OLLAMA_CLOUD_MODEL=gpt-oss:120b
# OLLAMA_CLOUD_FAST_MODEL=gpt-oss:120b
# OLLAMA_CLOUD_HOST=https://ollama.com

# --- Local Ollama (optional; no API key required) ---
# Run: ollama serve && ollama pull llama3.1
# Server-side synthesis uses this host when set (or browser Settings → Local).
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# --- Optional USPTO PatentsView (improves patent recall) ---
# PATENTSVIEW_API_KEY=

# Legacy aliases also accepted by serverEnv.ts:
# OLLAMA_API_KEY=

# --- Firebase (client SDK — safe as NEXT_PUBLIC_*; restrict domains in Console) ---
# From Firebase Console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=chemistryrecipes.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=chemistryrecipes
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=chemistryrecipes.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Realtime Database URL (Console → Realtime Database)
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://chemistryrecipes-default-rtdb.firebaseio.com

# --- Firebase Admin SDK (server-only; local troubleshooting) ---
# Put the service-account JSON under secrets/firebase/ (gitignored). See secrets/README.md
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase/chemistryrecipes-firebase-adminsdk-XXXX.json
# FIREBASE_ADMIN_PROJECT_ID=chemistryrecipes
# On App Hosting, prefer ADC / apphosting secrets — never bake the JSON into the image.
